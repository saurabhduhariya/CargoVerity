# ==========================================
# CARGOVERITY ENVIRONMENT CONFIGURATION
# ==========================================
# Copy to .env and fill in locally. .env is git-ignored; never commit real values.
# `npm ci`, `npm run build` and `npm test` work with every value below left empty.

# APPLICATION
APP_URL=http://localhost:3000

# SUPABASE - Browser-safe configuration (the only values exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SUPABASE - Server-only configuration
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shipment-documents

# POSTGRESQL - PRISMA 7
# DATABASE_URL: pooled runtime connection. DIRECT_URL: direct/session connection used by the
# Prisma CLI (migrations). When DIRECT_URL is set the app runtime also prefers it, because
# interactive transactions need a session connection.
DATABASE_URL=
DIRECT_URL=

# AI PROVIDER (exactly one is used; there is no automatic failover)
AI_PROVIDER=groq

# GROQ - PRIMARY PROVIDER
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OPENROUTER - ALTERNATIVE PROVIDER
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OPERATING LIMITS (defaults shown; MAX_PDF_PAGES <= 50, MAX_AI_IMAGES_PER_REQUEST <= 3, MAX_AI_RETRIES <= 1)
MAX_PDF_BYTES=10485760
MAX_IMAGE_BYTES=7000000
MAX_PDF_PAGES=50
MAX_AI_IMAGES_PER_REQUEST=3
MAX_AI_RETRIES=1
# Output cap per AI request (256-8000). A response cut off at this cap fails safely as INVALID_RESPONSE.
AI_MAX_COMPLETION_TOKENS=1000
# Per-request provider timeout in milliseconds (5000-120000).
AI_REQUEST_TIMEOUT_MS=60000
LOW_CONFIDENCE_THRESHOLD=0.85

# DETERMINISTIC CROSS-CHECK TOLERANCES (non-negative decimals)
# Gross weight passes when |difference| <= max(CHECK_WEIGHT_TOLERANCE_KG, larger weight x PERCENT / 100).
CHECK_WEIGHT_TOLERANCE_PERCENT=0.5
CHECK_WEIGHT_TOLERANCE_KG=0
# Invoice arithmetic passes when |expected - stated total| <= this amount in the invoice currency.
CHECK_MONETARY_TOLERANCE=0.01

# EXPORT AND RETENTION
EXPORT_PROFILE_ID=demo-v1
# Pending client policy; leave empty until a retention period is approved.
DOCUMENT_RETENTION_DAYS=

# CONTROLLED ROLE SEED (npm run db:seed)
# The IDs must already exist in Supabase Auth. Roles are granted only by this seed,
# never by the browser or by self sign-up.
# SEED_EXECUTIVE_ID=
# SEED_EXECUTIVE_EMAIL=
# SEED_EXECUTIVE_NAME=Synthetic Executive
# SEED_MANAGER_ID=
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_NAME=Synthetic Manager

# PLAYWRIGHT E2E (synthetic accounts only; authenticated specs are skipped when empty)
# PLAYWRIGHT_E2E_EMAIL=
# PLAYWRIGHT_E2E_PASSWORD=
# PLAYWRIGHT_MANAGER_EMAIL=
# PLAYWRIGHT_MANAGER_PASSWORD=
