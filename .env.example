# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase browser-safe configuration. Supplied at runtime by the server.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_PLACEHOLDER
SUPABASE_STORAGE_BUCKET=shipment-documents

# Server-only PostgreSQL / Prisma configuration
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_OR_SESSION_POOLER_HOST:5432/DATABASE

# Server-only Vertex AI configuration
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=asia-south1
GEMINI_MODEL_ID=VERIFIED_MODEL_ID

# Application policies and cost controls
MAX_PDF_BYTES=10485760
MAX_IMAGE_BYTES=7000000
MAX_PDF_PAGES=50
LOW_CONFIDENCE_THRESHOLD=0.85
MAX_AI_RETRIES=1
MONTHLY_AI_BUDGET_INR=SET_BY_OWNER
EXPORT_PROFILE_ID=demo-v1
DOCUMENT_RETENTION_DAYS=SET_BY_CLIENT_POLICY
